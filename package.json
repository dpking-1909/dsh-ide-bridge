{
  "name": "dsh-ide-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Right-sidebar code workbench for DeepSeek Harness: edit workspace files in place, mirrored with the local VS Code or Cursor.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "editor",
    "vscode",
    "cursor",
    "mirror"
  ],
  "scripts": {
    "check": "node --check index.js && node --check mirror.js && node --check editors.js && node --check client.js && node --check extension/extension.js",
    "verify": "node scripts/verify.mjs",
    "build:vsix": "node scripts/build-vsix.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "editors.js",
    "mirror.js",
    "client.js",
    "extension",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dpking-1909/dsh-ide-bridge.git"
  },
  "homepage": "https://github.com/dpking-1909/dsh-ide-bridge",
  "bugs": {
    "url": "https://github.com/dpking-1909/dsh-ide-bridge/issues"
  }
}
